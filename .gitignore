# ===========================================================================
#  Movira — what goes into git
#
#  Rule of thumb: SOURCE ONLY. Everything that can be regenerated by
#  `npm install` / `npm run dist` / `gradlew assembleRelease` is ignored,
#  so the repository stays small and a fresh clone builds from scratch.
# ===========================================================================

# ---------------------------------------------------------------------------
# Dependencies (restored with `npm install`)
# ---------------------------------------------------------------------------
node_modules/
.npm/
.yarn/

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
# Desktop: Vite renderer bundle + electron-builder installer
desktop/dist/
desktop/release/
desktop/out/
desktop/.vite/

# Shared core: compiled TypeScript
shared-core/dist/

# React Native / Android / Gradle
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/.cxx/
mobile/android/app/.cxx/
mobile/android/local.properties
mobile/android/.idea/
mobile/android/app/src/main/assets/index.android.bundle
*.iml
*.hprof

# ---------------------------------------------------------------------------
# Signing keys — never commit a real release key.
# The debug keystore is the well-known React Native default and IS committed
# so debug builds work on a fresh clone.
# ---------------------------------------------------------------------------
*.jks
*.keystore
!mobile/android/app/debug.keystore

# ---------------------------------------------------------------------------
# Built installers / packages (also: the 100 MB GitHub hard limit)
# ---------------------------------------------------------------------------
*.apk
*.aab
*.app
*.exe
*.msi
*.dmg
*.blockmap
latest.yml

# ---------------------------------------------------------------------------
# Media samples & test assets — huge, and not source
# ---------------------------------------------------------------------------
desktop/testmedia/
*.mkv
*.mp4
*.avi
*.wmv
*.webm
*.mov
*.m4v
*.flv
*.3gp
*.vob
*.mpg
*.mpeg
*.m4a
*.aiff
*.ape
sample ts 1080p.ts
sample_1920x1080.ts
sample_1280x720.ts

# ---------------------------------------------------------------------------
# Local scratch: screenshots, diagnostics, test captures
# ---------------------------------------------------------------------------
_shots/
verify/
_audiotest/
desktop/_audiotest/
desktop/_asarchk/
desktop/desktest.cjs
.freebuff/
start
*.log
eb-build.log

# ---------------------------------------------------------------------------
# Root-level sample screenshots (the real assets live under
# desktop/public/ and mobile/android/app/src/main/res/)
# ---------------------------------------------------------------------------
1.jpg
audiosample*.jpeg
videosample*.jpg
videosample*.png
moviramobilenewfeatures/*.jpeg

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
