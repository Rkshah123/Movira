{
  "name": "movira-desktop",
  "version": "1.0.0",
  "description": "Movira media player for desktop",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "main:build": "tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "start": "electron .",
    "dist": "npm run main:build && vite build && electron-builder --win --x64",
    "dist:portable": "npm run main:build && vite build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^10.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  }
}
