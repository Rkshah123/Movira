+    private fun getPickFilesLauncher(): ActivityResultLauncher<Array<String>> {
+        if (pickFilesLauncher == null) {
+            val registry = (reactApplicationContext.currentActivity as ReactActivity).activityResultRegistry
+            pickFilesLauncher = registry.register<Array<String>, List<Uri>>(
+                    "RNFS_pickFiles",
+                    OpenMultipleDocuments()
+            ) { uris ->
+                val res = Arguments.createArray()
+                if (uris != null) for (uri in uris) res.pushString(uri.toString())
+                pendingPickFilePromises.pop().resolve(res)
+            }
+        }
+        return pickFilesLauncher!!
+    }
